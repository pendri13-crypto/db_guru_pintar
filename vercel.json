{
    "version": 2,
    "builds": [
        {
            "src": "api/index.php",
            "use": "vercel-php@0.9.0"
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "true",
        "APP_KEY": "base64:UkxmtmSBvBH9QgPzCgj55p62vbRQ16AbTJOPa+osSeI=",
        "APP_URL": "https://db-guru-pintar.vercel.app",
        "CACHE_STORE": "array",
        "SESSION_DRIVER": "cookie",
        "QUEUE_CONNECTION": "sync",
        "LOG_CHANNEL": "stderr",
        "APP_MAINTENANCE_DRIVER": "file",
        "BROADCAST_CONNECTION": "log",
        "FILESYSTEM_DISK": "local",
        "DB_CONNECTION": "mysql",
        "DB_HOST": "gateway01.ap-northeast-1.prod.aws.tidbcloud.com",
        "DB_PORT": "4000",
        "DB_DATABASE": "test",
        "DB_USERNAME": "29kYqjQRkkQMXU8.root",
